---
import { addAffiliateParam } from '../utils/affiliate';
import LazyImage from './LazyImage.astro';

interface Props {
  title: string;
  price: number;
  originalPrice?: number;
  image: string;
  url: string;
  badge?: string;
  rating?: number;
  reviews?: number;
  freeShipping?: boolean;
  verdict?: string;
  pros?: string[];
  cons?: string[];
  /**
   * Modo de compra:
   * - 'store': producto propio del catálogo (botón comprar directa)
   * - 'affiliate': producto de Mercado Libre (link afiliado secundario)
   * - 'unavailable': sin stock, mostrar aviso
   */
  source?: 'store' | 'affiliate' | 'unavailable';
  /** ID del producto en catálogo propio (para checkout) */
  productId?: string;
  /** Stock disponible */
  stock?: number;
}

const {
  title,
  price,
  originalPrice,
  image,
  url,
  badge,
  rating = 0,
  reviews = 0,
  freeShipping = false,
  verdict,
  pros = [],
  cons = [],
  source = 'affiliate',
  productId,
  stock,
} = Astro.props;

const discount = originalPrice
  ? Math.round(((originalPrice - price) / originalPrice) * 100)
  : 0;

const formattedPrice = new Intl.NumberFormat('es-AR', {
  style: 'currency',
  currency: 'ARS',
  maximumFractionDigits: 0,
}).format(price);

const formattedOriginal = originalPrice
  ? new Intl.NumberFormat('es-AR', {
      style: 'currency',
      currency: 'ARS',
      maximumFractionDigits: 0,
    }).format(originalPrice)
  : null;

const affiliateUrl = addAffiliateParam(url);

// Schema.org dinámico según fuente
const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": title,
  "image": new URL(image, Astro.site || Astro.url).toString(),
  "offers": {
    "@type": "Offer",
    "url": source === 'store' ? new URL(`/producto/${productId || ''}`, Astro.site || Astro.url).toString() : affiliateUrl,
    "priceCurrency": "ARS",
    "price": price,
    "itemCondition": "https://schema.org/NewCondition",
    "availability": source === 'store' && stock !== undefined && stock > 0
      ? "https://schema.org/InStock"
      : source === 'unavailable'
        ? "https://schema.org/OutOfStock"
        : "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "VASTTO"
    }
  },
  ...(rating > 0 && reviews > 0 ? {
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": rating,
      "reviewCount": reviews
    }
  } : {})
};
---

<article class="product-card" data-source={source}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {badge && <span class="badge">{badge}</span>}
  
  <!-- Card Link -->
  <a
    href={source === 'store' && productId ? `/producto/${productId}` : affiliateUrl}
    target={source === 'store' ? undefined : '_blank'}
    rel={source === 'store' ? undefined : 'noopener sponsored'}
    class="card-link"
  >
    <div class="card-image">
      <LazyImage src={image} alt={title} class="card-img" />
    </div>
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      {rating > 0 && (
        <div class="rating">
          <span class="stars">{'★'.repeat(Math.round(rating))}</span>
          <span class="reviews">({reviews})</span>
        </div>
      )}
      <div class="card-pricing">
        {formattedOriginal && <span class="original-price">{formattedOriginal}</span>}
        <span class="price">{formattedPrice}</span>
        {discount > 0 && <span class="discount">-{discount}% OFF</span>}
      </div>
      {freeShipping && <span class="free-shipping">✓ Envío gratis</span>}

      <!-- Veredicto VASTTO -->
      {verdict && (
        <div class="vastto-verdict">
          <h4>Veredicto VASTTO</h4>
          <p>{verdict}</p>
          {(pros.length > 0 || cons.length > 0) && (
            <div class="pros-cons">
              {pros.length > 0 && (
                <div class="pros">
                  <ul>{pros.map((pro: string) => <li><span class="icon">✓</span> {pro}</li>)}</ul>
                </div>
              )}
              {cons.length > 0 && (
                <div class="cons">
                  <ul>{cons.map((con: string) => <li><span class="icon">✕</span> {con}</li>)}</ul>
                </div>
              )}
            </div>
          )}
        </div>
      )}

      <!-- Botón según fuente -->
      {source === 'store' && productId && (
        <button class="btn-buy btn-store" data-product-id={productId}>
          [PENDIENTE] Comprar en VASTTO
        </button>
      )}
      {source === 'store' && !productId && (
        <button class="btn-buy btn-store" disabled>
          [PENDIENTE] Sin ID de producto
        </button>
      )}
      {source === 'affiliate' && (
        <button class="btn-buy btn-affiliate">
          [PENDIENTE] Ver alternativa en ML
        </button>
      )}
      {source === 'unavailable' && (
        <button class="btn-buy btn-unavailable" disabled>
          Sin stock
        </button>
      )}
    </div>
  </a>
</article>

<style>
  .product-card {
    background: var(--vastto-surface);
    border-radius: 12px;
    border: 1px solid var(--vastto-border);
    padding: 1.5rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 4px 15px var(--vastto-shadow);
  }
  .product-card[data-source="store"] { border-color: #10b981; border-width: 2px; }
  .product-card[data-source="affiliate"] { border-color: var(--vastto-border); }
  .product-card[data-source="unavailable"] { opacity: 0.7; border-color: #ef4444; }
  .product-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px var(--vastto-shadow); }
  .badge {
    position: absolute; top: 10px; right: 10px;
    background: var(--text-main); color: var(--vastto-bg);
    padding: 4px 10px; border-radius: 6px;
    font-size: 0.75rem; font-weight: 800; z-index: 10;
  }
  .card-link { text-decoration: none; color: inherit; display: flex; flex-direction: column; flex-grow: 1; }
  .card-image { width: 100%; aspect-ratio: 1; overflow: hidden; background: var(--vastto-surface); padding: 1rem; border-bottom: 1px solid rgba(0,0,0,0.02); }
  .card-image img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.4s ease; }
  .card-body { padding: 1.25rem; display: flex; flex-direction: column; flex-grow: 1; background: var(--vastto-surface); }
  .card-title { font-size: 1.15rem; font-weight: 800; margin: 0 0 1rem; line-height: 1.3; color: var(--text-main); }
  .rating { font-size: 0.85rem; margin-bottom: 0.75rem; display: flex; align-items: center; }
  .stars { color: #f59e0b; letter-spacing: 1px; }
  .reviews { color: var(--text-light); margin-left: 6px; font-weight: 500; }
  .card-pricing { margin-bottom: 1rem; }
  .original-price { font-size: 1rem; text-decoration: line-through; color: var(--text-light); }
  .price { font-size: 1.5rem; font-weight: 800; color: var(--text-main); display: block; }
  .discount { color: #10b981; font-weight: 700; font-size: 0.85rem; }
  .free-shipping { color: #10b981; font-size: 0.85rem; font-weight: 600; display: block; margin-top: 0.25rem; }
  .vastto-verdict { background: var(--vastto-bg-alt); border-radius: 8px; padding: 1rem; margin-bottom: 1rem; border-left: 3px solid #6c47ff; font-size: 0.85rem; }
  .vastto-verdict h4 { margin: 0 0 0.5rem 0; color: var(--text-main); font-size: 0.9rem; font-weight: 800; }
  .vastto-verdict p { margin: 0 0 0.75rem 0; color: var(--text-body); line-height: 1.4; }
  .pros-cons { display: flex; flex-direction: column; gap: 0.5rem; }
  .pros, .cons { margin: 0; padding: 0; list-style: none; }
  .pros li { color: #10b981; margin-bottom: 2px; }
  .cons li { color: #ef4444; margin-bottom: 2px; }
  .btn-buy {
    width: 100%; border: none; border-radius: 8px;
    padding: 0.75rem 1rem; font-weight: 700; font-size: 0.95rem;
    cursor: pointer; transition: all 0.3s ease; margin-top: auto;
    min-height: 44px; display: flex; align-items: center; justify-content: center;
  }
  .btn-store { background: #10b981; color: #fff; }
  .btn-store:hover { background: #059669; }
  .btn-store:disabled { background: #9ca3af; cursor: not-allowed; }
  .btn-affiliate { background: #6c47ff; color: #fff; }
  .btn-affiliate:hover { background: #5535e0; }
  .btn-unavailable { background: #ef4444; color: #fff; cursor: not-allowed; }
</style>
