---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, FOUNDER_NAME, FOUNDER_ROLE, FOUNDER_LOCATION, LINKEDIN_URL, GITHUB_URL } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- 1. HERO SECTION -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge-wrap">
          <span class="badge badge-cyan">
            <span class="pulse-dot"></span>
            ESTUDIO TECNOLÓGICO INDEPENDIENTE • SAN RAFAEL, MENDOZA
          </span>
        </div>
        
        <h1 class="hero-title">
          Tu empresa puede hacer más con la <span class="text-gradient-cyan">tecnología adecuada.</span>
        </h1>
        
        <p class="hero-subtitle">
          Desarrollamos software a medida, automatizaciones de procesos e inteligencia artificial aplicada para ayudar a las empresas a captar oportunidades, eliminar cuellos de botella y crecer con eficiencia operativa.
        </p>

        <!-- Píldoras de Confianza Técnica -->
        <div class="hero-trust-pills">
          <div class="trust-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>Desarrollo Local en San Rafael</span>
          </div>
          <div class="trust-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>Sistemas y Código a Medida</span>
          </div>
          <div class="trust-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>Privacidad Total y Datos Propios</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="#contacto" class="btn btn-primary btn-lg">
            <span>Solicitar Diagnóstico Sin Cargo</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/demos" class="btn btn-secondary btn-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <span>Ver Demos Interactivas</span>
          </a>
        </div>
      </div>

      <!-- Mockup Visual Hero: Terminal de Automatización Inteligente en Vivo -->
      <div class="hero-visual">
        <div class="terminal-window">
          <div class="terminal-header">
            <div class="terminal-buttons">
              <span class="terminal-dot dot-red"></span>
              <span class="terminal-dot dot-yellow"></span>
              <span class="terminal-dot dot-green"></span>
            </div>
            <div class="terminal-title">vastto-agent-pipeline v2.4 // status: running</div>
            <div class="badge badge-emerald" style="padding: 0.2rem 0.5rem; font-size: 0.68rem;">ONLINE</div>
          </div>
          <div class="terminal-body">
            <p><span style="color: #64748b;">[14:40:02]</span> <span style="color: #00f0ff;">EVENT_INGEST:</span> Nueva consulta comercial recibida vía WhatsApp</p>
            <p><span style="color: #64748b;">[14:40:03]</span> <span style="color: #a855f7;">AI_PARSER:</span> Analizando texto del cliente y extrayendo intención...</p>
            <div class="terminal-code-block">
              {`{
  "cliente": "Inmobiliaria & Desarrollos Cuyo",
  "origen": "WhatsApp Business API",
  "intencion": "COMPRA_TERRENO_URBANO",
  "presupuesto_usd": 65000,
  "lead_score": 92,
  "accion_automatica": "NOTIFICAR_ASESOR_ZONA_SUR"
}`}
            </div>
            <p><span style="color: #64748b;">[14:40:04]</span> <span style="color: #10b981;">CRM_SYNC:</span> Prospecto clasificado en etapa QUALIFIED. Tarea asignada en 0.4s.</p>
            <p><span style="color: #64748b;">[14:40:05]</span> <span style="color: #6366f1;">BOT_DISPATCH:</span> Enviado catálogo PDF personalizado y enlace de agenda.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SECCIÓN: PROBLEMAS EMPRESARIALES QUE RESOLVEMOS -->
  <section class="section" style="background: rgba(14, 17, 26, 0.4); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-indigo section-eyebrow">DIAGNÓSTICO COMERCIAL & OPERATIVO</span>
        <h2>Los cuellos de botella que frenan a las empresas</h2>
        <p class="section-desc">
          La mayoría de las empresas pierden dinero no por falta de clientes, sino por procesos lentos, dispersión de información y tareas manuales que un sistema puede resolver en segundos.
        </p>
      </div>

      <div class="grid-2">
        <div class="card-tech">
          <div class="pain-icon-wrap" style="color: #ef4444; background: rgba(239, 68, 68, 0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
          </div>
          <h3>Consultas perdidas por demoras en la atención</h3>
          <p>
            Un cliente interesado que espera más de 30 minutos en WhatsApp o web consulta a la competencia. Sin calificación previa, tu equipo comercial gasta horas respondiendo preguntas básicas a curiosos que nunca van a comprar.
          </p>
          <div class="solution-bridge">
            <span class="solution-label">Solución VASTTO:</span>
            <span>Asistentes comerciales 24/7 con calificación automática de presupuesto y filtrado de intención antes de transferir al asesor.</span>
          </div>
        </div>

        <div class="card-tech">
          <div class="pain-icon-wrap" style="color: #f59e0b; background: rgba(245, 158, 11, 0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <h3>Carga manual repetitiva entre Excel y papel</h3>
          <p>
            Personal administrativo copiando y pegando datos entre planillas, recibos, comprobantes y mensajes de chat. Alto riesgo de error humano, duplicación de pedidos y horas de trabajo desperdiciadas.
          </p>
          <div class="solution-bridge">
            <span class="solution-label">Solución VASTTO:</span>
            <span>Automatización de flujos con Python y APIs que sincronizan pedidos, emiten alertas y actualizan inventarios sin intervención humana.</span>
          </div>
        </div>

        <div class="card-tech">
          <div class="pain-icon-wrap" style="color: #a855f7; background: rgba(168, 85, 247, 0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <h3>Software enlatado que no se adapta al negocio</h3>
          <p>
            Sistemas estándar con costos mensuales en dólares que obligan a tu negocio a cambiar su forma de trabajar, llenos de módulos innecesarios y sin posibilidad de conectar con tus herramientas actuales.
          </p>
          <div class="solution-bridge">
            <span class="solution-label">Solución VASTTO:</span>
            <span>Desarrollo de software a medida, ligero y propio, donde la empresa es dueña total del sistema y solo paga por lo que realmente utiliza.</span>
          </div>
        </div>

        <div class="card-tech">
          <div class="pain-icon-wrap" style="color: #00f0ff; background: rgba(0, 240, 255, 0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
          </div>
          <h3>Sitios web lentos que no generan clientes</h3>
          <p>
            Páginas web obsoletas diseñadas como folletos estáticos que tardan 6 segundos en abrir en el celular, sin optimización de búsqueda local en Google y sin caminos claros para que el visitante inicie contacto.
          </p>
          <div class="solution-bridge">
            <span class="solution-label">Solución VASTTO:</span>
            <span>Arquitectura web estática en Astro de ultra-rápida velocidad, SEO técnico local para San Rafael y Mendoza, y arquitectura orientada a la conversión.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CATÁLOGO DE SERVICIOS JERARQUIZADO -->
  <section class="section" id="servicios">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-cyan section-eyebrow">CAPACIDADES TECNOLÓGICAS</span>
        <h2>Servicios diseñados para generar retorno de inversión</h2>
        <p class="section-desc">
          Priorizamos soluciones que resuelven cuellos de botella operativos y aumentan la capacidad comercial de tu empresa.
        </p>
      </div>

      <div class="grid-2" style="gap: 2rem;">
        <!-- Servicio 1: Automatización -->
        <div class="card-tech service-card-featured">
          <div class="service-tag-badge">SERVICIO PRINCIPAL</div>
          <div class="service-header">
            <div class="service-icon">⚡</div>
            <div>
              <h3>Automatización de Procesos</h3>
              <p class="service-subtitle">Elimina tareas manuales repetitivas y acelera tus ventas</p>
            </div>
          </div>
          <p class="service-text">
            Construimos pipelines que conectan tu sitio web, formularios, WhatsApp Business, hojas de cálculo y bases de datos para que la información fluya sin errores humanos.
          </p>
          <ul class="service-feature-list">
            <li>✔ Captación y calificación instantánea de prospectos comerciales.</li>
            <li>✔ Integración oficial de WhatsApp para respuestas y alertas automáticas.</li>
            <li>✔ Sistemas de seguimiento comercial (CRM local-first sin suscripciones caras).</li>
            <li>✔ Automatización de presupuestos, órdenes de compra y facturación.</li>
          </ul>
          <div class="service-actions">
            <a href="/automatizacion" class="btn btn-secondary btn-sm">Ver detalles del servicio →</a>
            <span class="tech-stack-tag">Python • FastAPI • Webhooks • SQL</span>
          </div>
        </div>

        <!-- Servicio 2: Inteligencia Artificial -->
        <div class="card-tech service-card-featured">
          <div class="service-tag-badge" style="background: rgba(168, 85, 247, 0.15); color: #c084fc; border-color: rgba(168, 85, 247, 0.3);">SERVICIO PRINCIPAL</div>
          <div class="service-header">
            <div class="service-icon">🧠</div>
            <div>
              <h3>Inteligencia Artificial & Agentes</h3>
              <p class="service-subtitle">Asistentes operativos y modelos de lenguaje aplicados</p>
            </div>
          </div>
          <p class="service-text">
            Implementamos agentes autónomos y modelos LLM (remotos o locales) para interpretar texto, clasificar documentos complejos y asistir a tu equipo en decisiones diarias.
          </p>
          <ul class="service-feature-list">
            <li>✔ Agentes de triaje y atención entrenados con los datos de tu empresa.</li>
            <li>✔ Procesamiento y extracción inteligente de datos en PDFs y comprobantes.</li>
            <li>✔ Clasificación semántica de correos e intenciones de compra.</li>
            <li>✔ Infraestructura con protección estricta de privacidad y sin fugas de datos.</li>
          </ul>
          <div class="service-actions">
            <a href="/inteligencia-artificial" class="btn btn-secondary btn-sm">Ver detalles del servicio →</a>
            <span class="tech-stack-tag">LLMs • LangChain • Ollama • Prompt Defense</span>
          </div>
        </div>

        <!-- Servicio 3: Desarrollo a Medida -->
        <div class="card-tech">
          <div class="service-tag-badge">SERVICIO PRINCIPAL</div>
          <div class="service-header">
            <div class="service-icon">💻</div>
            <div>
              <h3>Desarrollo de Software a Medida</h3>
              <p class="service-subtitle">Aplicaciones web, APIs y paneles administrativos propios</p>
            </div>
          </div>
          <p class="service-text">
            Desarrollamos soluciones de software diseñadas exactamente para las reglas de tu negocio, con interfaces claras, alta velocidad y código 100% de tu propiedad.
          </p>
          <ul class="service-feature-list">
            <li>✔ Paneles de control internos (dashboards) y herramientas operativas.</li>
            <li>✔ Desarrollo de APIs RESTful robustas y seguras.</li>
            <li>✔ Migración de hojas de cálculo a bases de datos relacionales SQLite / PostgreSQL.</li>
            <li>✔ Extracción autorizada de información pública y scrapers especializados.</li>
          </ul>
          <div class="service-actions">
            <a href="/desarrollo" class="btn btn-secondary btn-sm">Ver detalles del servicio →</a>
            <span class="tech-stack-tag">Astro • Python • TypeScript • Docker</span>
          </div>
        </div>

        <!-- Servicio 4: Marketing Tecnológico -->
        <div class="card-tech">
          <div class="service-tag-badge" style="background: rgba(16, 185, 129, 0.15); color: #6ee7b7; border-color: rgba(16, 185, 129, 0.3);">COMPLEMENTARIO</div>
          <div class="service-header">
            <div class="service-icon">📈</div>
            <div>
              <h3>SEO Técnico & Meta Ads</h3>
              <p class="service-subtitle">Optimización de captación digital y visibilidad local</p>
            </div>
          </div>
          <p class="service-text">
            Complementamos los sistemas internos asegurando que los clientes potenciales encuentren tu empresa en Google y mediante campañas segmentadas de Meta Ads.
          </p>
          <ul class="service-feature-list">
            <li>✔ SEO local para posicionar en San Rafael, Mendoza y Argentina.</li>
            <li>✔ Optimización de Core Web Vitals para tiempos de carga menores a 1 segundo.</li>
            <li>✔ Landing pages de ultra-alta conversión conectadas a tu WhatsApp.</li>
            <li>✔ Campañas de anuncios orientadas a costo por lead calificado.</li>
          </ul>
          <div class="service-actions">
            <a href="/marketing-digital" class="btn btn-secondary btn-sm">Ver detalles del servicio →</a>
            <span class="tech-stack-tag">Technical SEO • Meta Ads • Web Vitals</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SOLUCIONES POR INDUSTRIA -->
  <section class="section" style="background: rgba(10, 13, 20, 0.6); border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-emerald section-eyebrow">SECTORES ESPECIALIZADOS</span>
        <h2>Soluciones adaptadas a la realidad de tu rubro</h2>
        <p class="section-desc">
          Entendemos la dinámica comercial de las empresas de San Rafael y Mendoza. Diseñamos soluciones con terminología y flujos adaptados a cada industria.
        </p>
      </div>

      <div class="grid-3">
        <!-- Inmobiliarias -->
        <div class="card-tech">
          <div class="industry-badge">INMOBILIARIAS & DESARROLLOS</div>
          <h3>Asistente de Calificación Inmobiliaria</h3>
          <p>
            Filtra y clasifica compradores e inquilinos por presupuesto, zona preferida y tipo de propiedad. Asigna visitas a los agentes y automatiza el seguimiento comercial.
          </p>
          <div class="industry-metric">
            <span class="metric-val">100%</span>
            <span class="metric-lbl">de consultas respondidas en el primer minuto</span>
          </div>
          <a href="/soluciones/inmobiliarias" class="industry-link">Ver solución inmobiliaria →</a>
        </div>

        <!-- Concesionarias -->
        <div class="card-tech">
          <div class="industry-badge">CONCESIONARIAS & AUTOS</div>
          <h3>Gestor Comercial de Vehículos</h3>
          <p>
            Captura consultas por vehículos 0km y usados, calcula simulaciones de cuotas, evalúa ofertas de permutas y envía fichas de prospectos al equipo de ventas.
          </p>
          <div class="industry-metric">
            <span class="metric-val">-65%</span>
            <span class="metric-lbl">tiempo perdido en consultas no calificadas</span>
          </div>
          <a href="/soluciones/automotrices" class="industry-link">Ver solución automotriz →</a>
        </div>

        <!-- Distribuidoras -->
        <div class="card-tech">
          <div class="industry-badge">DISTRIBUIDORAS & MAYORISTAS</div>
          <h3>Automatización de Pedidos y Stock</h3>
          <p>
            Permite a clientes comerciales enviar pedidos por WhatsApp o web, procesa listas de precios dinámicas y genera órdenes listas para depósito y facturación.
          </p>
          <div class="industry-metric">
            <span class="metric-val">0</span>
            <span class="metric-lbl">errores de transcripción manual de pedidos</span>
          </div>
          <a href="/soluciones/distribuidoras" class="industry-link">Ver solución distribuidoras →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. CENTRO DE DEMOSTRACIONES INTERACTIVAS EN VIVO -->
  <section class="section" id="demos">
    <div class="container">
      <div class="demo-banner-box">
        <div class="demo-banner-content">
          <span class="badge badge-cyan">PRUÉBALO EN TU NAVEGADOR</span>
          <h2>Experimenta las soluciones antes de contratarlas</h2>
          <p>
            Hemos desarrollado prototipos interactivos que puedes probar ahora mismo desde tu navegador con datos sintéticos. Comprueba cómo se siente la velocidad y la automatización real.
          </p>
          <div class="demo-buttons">
            <a href="/demos/inmobiliaria" class="btn btn-primary">Demo Inmobiliaria</a>
            <a href="/demos/automotriz" class="btn btn-secondary">Demo Automotriz</a>
            <a href="/demos/automatizacion" class="btn btn-secondary">Demo Agente IA</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. PORTFOLIO DE PROYECTOS VERIFICADOS -->
  <section class="section" id="proyectos" style="background: rgba(14, 17, 26, 0.3);">
    <div class="container">
      <div class="section-title-wrap">
        <span class="badge badge-indigo section-eyebrow">PORTFOLIO Y CASOS REALES</span>
        <h2>Software real, probado y documentado</h2>
        <p class="section-desc">
          No mostramos falsos casos de éxito ni métricas inventadas. Mostramos ingeniería de software comprobable y proyectos construidos con rigor técnico.
        </p>
      </div>

      <div class="grid-3">
        <!-- CUYOPROSPECT -->
        <div class="card-tech">
          <div class="project-tag">PROYECTO PROPIO DE INGENIERÍA</div>
          <h3>CUYOPROSPECT</h3>
          <p class="project-summary">
            Sistema local-first de prospección comercial ética, auditoría técnica web y CRM B2B para empresas de Cuyo.
          </p>
          <div class="project-specs">
            <div><strong>Backend:</strong> Python, FastAPI, SQLite WAL</div>
            <div><strong>Frontend:</strong> Astro 5, Tailwind CSS</div>
            <div><strong>Auditoría:</strong> 53 tests unitarios aprobados, 83% cobertura</div>
          </div>
          <p class="project-note">Arquitectura desacoplada, defensa anti-SSRF y garantía Human-in-the-Loop.</p>
        </div>

        <!-- Razón y Asombro -->
        <div class="card-tech">
          <div class="project-tag">PUBLICACIÓN EDITORIAL</div>
          <h3>Razón y Asombro</h3>
          <p class="project-summary">
            Plataforma editorial independiente de alto rendimiento optimizada para lectura profunda y SEO semántico.
          </p>
          <div class="project-specs">
            <div><strong>Stack:</strong> Astro SSG, MDX, CSS Moderno</div>
            <div><strong>Rendimiento:</strong> 100/100 Core Web Vitals en Google</div>
            <div><strong>Enfoque:</strong> Accesibilidad, tipografía cuidada y cero bloatware</div>
          </div>
          <p class="project-note">Diseño visual sobrio, estructuración Schema.org y velocidad instantánea.</p>
        </div>

        <!-- VASTTO 2.0 -->
        <div class="card-tech">
          <div class="project-tag">TRANSFORMACIÓN DIGITAL</div>
          <h3>VASTTO 2.0</h3>
          <p class="project-summary">
            Refundación completa de una plataforma de afiliados a un estudio de ingeniería de software e inteligencia artificial B2B.
          </p>
          <div class="project-specs">
            <div><strong>Arquitectura:</strong> Astro 4.x, TypeScript, Cloudflare Edge</div>
            <div><strong>Seguridad:</strong> Políticas de desindexación limpia sin Soft 404</div>
            <div><strong>Demos:</strong> Prototipos funcionales client-side con datos sintéticos</div>
          </div>
          <p class="project-note">Demostración práctica de migración arquitectónica sin interrumpir producción.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. SOBRE ANDRÉS CARRIZO -->
  <section class="section" id="sobre-mi">
    <div class="container">
      <div class="founder-card">
        <div class="founder-info">
          <span class="badge badge-cyan">LIDERAZGO TÉCNICO</span>
          <h2>Andrés Carrizo</h2>
          <p class="founder-role-title">Desarrollador Full Stack & Especialista en Automatizaciones</p>
          <p class="founder-bio">
            Resido en San Rafael, Mendoza. Mi enfoque de trabajo une dos mundos que rara vez dialogan bien: la rigurosidad técnica de la ingeniería de software y la comprensión pragmática de los problemas comerciales de una empresa.
          </p>
          <p class="founder-bio">
            No creo en vender "humo" de inteligencia artificial ni en cobrar abonos costosos por herramientas que nadie usa. Construyo soluciones concretas en Python, JavaScript y Astro que reducen horas de trabajo administrativo y ayudan a las empresas a conseguir y atender mejor a sus clientes.
          </p>

          <div class="skills-chips">
            <span class="skill-chip">Python</span>
            <span class="skill-chip">FastAPI</span>
            <span class="skill-chip">Astro</span>
            <span class="skill-chip">JavaScript / TS</span>
