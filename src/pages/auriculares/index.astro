---
import Layout from '../../layouts/Layout.astro';
import ProductCardV2 from '../../components/ProductCardV2.astro';

const products = [
  {
    title: "Sony WH-CH520 Inalámbricos",
    price: 87999,
    originalPrice: 105000,
    image: "/images/sony-wh-ch520-inal-mbricos.jpg",
    url: "https://www.mercadolibre.com.ar/auriculares-sony-wh-ch520-inalambricos/p/MLA22103546",
    badge: "🏆 MÁS VENDIDO",
    rating: 4.8,
    reviews: 11023,
    freeShipping: true,
    verdict: "El auricular más vendido de Argentina. 50 horas de batería, sonido equilibrado y micrófono excelente.",
    pros: ["Batería 50h", "Micrófono nítido", "Cómodos"],
    cons: ["Sin ANC", "Plástico frágil"],
    source: "unavailable" as const,
  },
  {
    title: "SoundPEATS Clear In-Ear",
    price: 49999,
    originalPrice: 65000,
    image: "/images/soundpeats-clear.jpg",
    url: "https://www.mercadolibre.com.ar/soundpeats-c30-hybrid-noise-cancelling-bluetooth-earphones/p/MLA2048863874",
    badge: "DISEÑO",
    rating: 4.6,
    reviews: 840,
    freeShipping: true,
    verdict: "Diseño transparente único, graves potentes y 40h de batería.",
    pros: ["Estética única", "Bajos potentes", "Batería 40h"],
    cons: ["Sin ANC", "Estuche se raya"],
    source: "unavailable" as const,
  },
  {
    title: "Samsung Galaxy Buds FE",
    price: 55000,
    originalPrice: 70000,
    image: "/images/samsung-galaxy-buds-fe.jpg",
    badge: "ANC",
    rating: 4.7,
    reviews: 1203,
    freeShipping: true,
    verdict: "El mejor ANC por menos de $60k. Ideal para transporte público.",
    pros: ["ANC real", "Integración Samsung"],
    cons: ["Batería justa", "IPX2"],
    source: "unavailable" as const,
  },
  {
    title: "Xiaomi Redmi Buds 6 Play",
    price: 21699,
    originalPrice: 49999,
    image: "/images/xiaomi-redmi-buds-6-play---negro.jpg",
    url: "https://www.mercadolibre.com.ar/auriculares-inalambricos-xiaomi-redmi-buds-6-play-negro/p/MLA39962085",
    badge: "TOP VENTAS",
    rating: 4.8,
    reviews: 6189,
    freeShipping: true,
    verdict: "Tu primer TWS obligado. 36h de batería por $22k.",
    pros: ["Batería 36h", "Precio imbatible"],
    cons: ["Sin ANC", "Graves débiles"],
    source: "unavailable" as const,
  },
  {
    title: "JBL Tune 510BT",
    price: 45999,
    originalPrice: 58000,
    image: "/images/jbl-tune-510bt-wireless.jpg",
    url: "https://www.mercadolibre.com.ar/auriculares-jbl-tune-510bt-negro/p/MLA17347134",
    badge: "JBL",
    rating: 4.8,
    reviews: 12431,
    freeShipping: true,
    verdict: "Bajos potentes JBL. 40h de batería y plegables.",
    pros: ["Bajos potentes", "40h batería", "Plegables"],
    cons: ["Sin ANC", "Almohadillas chicas"],
    source: "unavailable" as const,
  },
  {
    title: "HyperX Cloud Stinger 2 Core",
    price: 36692,
    image: "/images/hyperx-cloud-stinger-2-core---black.jpg",
    badge: "GAMER",
    rating: 5,
    reviews: 1125,
    freeShipping: true,
    verdict: "El auricular gamer más honesto. Micrófono que se mutea al levantar.",
    pros: ["Mic mute automático", "Compatible todo"],
    cons: ["Todo plástico", "Cable goma"],
    source: "unavailable" as const,
  },
];

const siloGuides = [
  { title: 'Mejores Auriculares Bluetooth Baratos', href: '/auriculares/mejores-bluetooth-baratos', tag: 'Top 5', desc: 'Los 5 mejores auriculares wireless por menos de $90k.' },
  { title: 'Auriculares con Cancelación de Ruido Baratos', href: '/auriculares/mejores-cancelacion-ruido-baratos', tag: 'ANC', desc: 'Aislá el ruido del bondi sin vender un riñón.' },
  { title: 'Sony WH-CH520: Review Completa', href: '/auriculares/sony-wh-ch520-review', tag: 'Review', desc: '¿Valen la pena los más vendidos de Argentina?' },
  { title: 'JBL Tune 510BT vs Sony WH-CH520', href: '/auriculares/jbl-tune-520bt-vs-sony-wh-ch520', tag: 'VS', desc: 'Los 2 over-ear más vendidos, frente a frente.' },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Auriculares en Argentina — Guías, Reviews y Mejores Precios | VASTTO",
  "description": "Guías, reviews y comparativas de auriculares en Argentina. Bluetooth, gamer, ANC, in-ear y over-ear con los mejores precios.",
  "url": "https://vastto.com.ar/auriculares",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": products.slice(0, 5).map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": { "@type": "Product", "name": p.title, "image": `https://vastto.com.ar${p.image}` }
    }))
  }
});
---

<Layout title="Auriculares en Argentina — Guías, Reviews y Mejores Precios | VASTTO" description="Guías, reviews y comparativas de auriculares en Argentina. Bluetooth, gamer, ANC, in-ear y over-ear con los mejores precios.">
  <script type="application/ld+json" set:html={schema} />

  <section class="hero-silo">
    <div class="container">
      <nav class="breadcrumb"><a href="/">Inicio</a> › <span>Auriculares</span></nav>
      <h1>Auriculares en Argentina: Guías, Reviews y Mejores Precios 2026</h1>
      <p>Tu centro de referencia para comprar auriculares inteligentemente. Comparamos modelos, analizamos pros y contras, y te mostramos los mejores precios.</p>
    </div>
  </section>

  <section class="silo-guides">
    <div class="container">
      <h2>📖 Guías y Comparativas de Auriculares</h2>
      <div class="guides-grid">
        {siloGuides.map(guide => (
          <a href={guide.href} class="guide-card">
            <span class="guide-tag">{guide.tag}</span>
            <h3>{guide.title}</h3>
            <p>{guide.desc}</p>
            <span class="guide-cta">Leer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="products-section">
    <div class="container">
      <div class="section-header">
        <h2>Auriculares Recomendados</h2>
        <p>{products.length} productos verificados con envío gratis</p>
      </div>
      <div class="products-grid">
        {products.map(product => (
          <ProductCardV2 {...product} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-silo { background: linear-gradient(135deg, #1a0a3e 0%, #3b1fa8 50%, #6c47ff 100%); padding: 4rem 0; color: white; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .breadcrumb { font-size: 0.9rem; color: rgba(255,255,255,0.7); margin-bottom: 1.5rem; }
  .breadcrumb a { color: rgba(255,255,255,0.85); text-decoration: none; }
  .hero-silo h1 { font-size: 2.75rem; font-weight: 800; margin: 0 0 0.75rem; }
  .hero-silo p { color: rgba(255,255,255,0.85); font-size: 1.15rem; max-width: 800px; line-height: 1.5; }
  .silo-guides { padding: 4rem 0; background: #f8f7ff; }
  .silo-guides h2 { font-size: 2rem; font-weight: 800; margin-bottom: 2rem; }
  .guides-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .guide-card { background: var(--vastto-surface); border-radius: 12px; padding: 1.75rem; text-decoration: none; border: 1px solid var(--vastto-border); box-shadow: 0 4px 15px var(--vastto-shadow); transition: all 0.3s ease; }
  .guide-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(108, 71, 255, 0.1); border-color: rgba(108, 71, 255, 0.2); }
  .guide-tag { background: rgba(108, 71, 255, 0.1); color: #6c47ff; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; display: inline-block; margin-bottom: 0.75rem; }
  .guide-card h3 { font-size: 1.15rem; color: var(--text-main); margin: 0 0 0.5rem; font-weight: 800; }
  .guide-card p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin: 0 0 1rem; }
  .guide-cta { color: #6c47ff; font-weight: 700; font-size: 0.9rem; }
  .products-section { padding: 4rem 0; background: var(--vastto-surface); }
  .section-header { margin-bottom: 2rem; }
  .section-header h2 { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
  .section-header p { color: var(--text-muted); }
  .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem; }
  @media (max-width: 768px) { .hero-silo h1 { font-size: 2rem; } .products-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; } .guides-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .products-grid { grid-template-columns: 1fr; } }
</style>
