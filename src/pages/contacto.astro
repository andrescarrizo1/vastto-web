---
import Layout from '../layouts/Layout.astro';
import { FOUNDER_NAME, FOUNDER_LOCATION, CONTACT_EMAIL, LINKEDIN_URL, GITHUB_URL, getWhatsAppLink, WA_MESSAGES, WHATSAPP_DISPLAY, WHATSAPP_ENABLED } from '../consts';
---

<Layout 
  title="Contacto & Solicitud de Presupuesto | VASTTO"
  description="Conversemos sobre las necesidades tecnológicas de tu empresa. Solicita un diagnóstico sin cargo o agenda una llamada con Andrés Carrizo."
>
  <section class="section" style="padding-top: 5rem;">
    <div class="container container-narrow">
      <div class="contact-header-wrap" style="text-align: center; margin-bottom: 3rem;">
        <span class="badge badge-emerald section-eyebrow">CANALES DIRECTOS</span>
        <h1>Iniciemos una conversación comercial</h1>
        <p style="font-size: 1.15rem; color: var(--text-secondary); max-width: 640px; margin: 1rem auto 0 auto;">
          Sin intermediarios ni ejecutivos de cuenta. Hablas directamente con {FOUNDER_NAME}, líder técnico de VASTTO.
        </p>
      </div>

      <div class="contact-box">
        {WHATSAPP_ENABLED && (
          <div class="whatsapp-quick-box" style="background: rgba(37, 211, 102, 0.08); border: 1px solid rgba(37, 211, 102, 0.35); border-radius: 12px; padding: 1.5rem; margin-bottom: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <div style="background: #25D366; color: #ffffff; width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.074-1.782-.395-1.294-.528-2.186-1.849-2.251-1.936-.064-.087-.528-.702-.528-1.341 0-.638.334-.952.453-1.077.12-.125.26-.156.347-.156.087 0 .173.001.248.006.079.004.185-.03.288.218.106.255.361.881.393.946.032.065.053.142.011.226-.043.084-.064.137-.128.213-.064.075-.134.168-.192.226-.064.064-.131.134-.056.263.075.129.333.549.715.889.492.438.906.574 1.035.638.129.064.205.054.281-.033.076-.087.325-.379.412-.508.087-.13.173-.109.29-.065.118.043.748.353.877.417.129.065.216.098.248.152.032.054.032.315-.112.72z"/>
                </svg>
              </div>
              <div>
                <h3 style="margin: 0; color: #ffffff; font-size: 1.1rem;">Atención Comercial Inmediata por WhatsApp</h3>
                <p style="margin: 0.25rem 0 0 0; font-size: 0.9rem; color: var(--text-secondary);">
                  Línea directa: <strong style="color: #ffffff;">{WHATSAPP_DISPLAY}</strong> • Andrés Carrizo
                </p>
                <span style="font-size: 0.8rem; color: var(--text-muted); display: block; margin-top: 0.2rem;">
                  Al presionar el botón serás redirigido a WhatsApp para confirmar y enviar tu mensaje.
                </span>
              </div>
            </div>
            <a 
              href={getWhatsAppLink(WA_MESSAGES.contacto)} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-whatsapp btn-lg"
            >
              <span>Abrir WhatsApp</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        )}

        <form class="contact-form" id="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="contact-nombre">Nombre y Apellido *</label>
              <input type="text" id="contact-nombre" name="nombre" required placeholder="Ej: Roberto Gómez" class="form-input" />
            </div>
            <div class="form-group">
              <label for="contact-empresa">Empresa o Negocio *</label>
              <input type="text" id="contact-empresa" name="empresa" required placeholder="Ej: Distribuidora Cuyo SA" class="form-input" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="contact-email">Email de Contacto *</label>
              <input type="email" id="contact-email" name="email" required placeholder="roberto@distribuidora.com.ar" class="form-input" />
            </div>
            <div class="form-group">
              <label for="contact-telefono">Teléfono / WhatsApp</label>
              <input type="tel" id="contact-telefono" name="telefono" placeholder="+54 9 260 4..." class="form-input" />
            </div>
          </div>

          <div class="form-group">
            <label for="contact-servicio">Servicio Principal de Interés *</label>
            <select id="contact-servicio" name="servicio" required class="form-input">
              <option value="automatizacion">Automatización de Procesos Comerciales y WhatsApp</option>
              <option value="ia">Agentes de Inteligencia Artificial y Triaje</option>
              <option value="desarrollo">Desarrollo de Software Web a Medida / APIs</option>
              <option value="marketing">SEO Técnico Local y Campañas Meta Ads</option>
              <option value="consultoria">Diagnóstico Tecnológico General</option>
            </select>
          </div>

          <div class="form-group">
            <label for="contact-mensaje">Descripción del Proyecto o Desafío *</label>
            <textarea id="contact-mensaje" name="mensaje" rows="5" required placeholder="Cuéntanos brevemente cuál es el proceso que más tiempo o dinero te hace perder hoy en tu empresa..." class="form-input"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">
            Enviar Solicitud vía Correo Directo
          </button>

          <p style="text-align: center; margin-top: 1rem; font-size: 0.88rem; color: var(--text-secondary);">
            ¿Prefieres escribir directamente desde tu aplicación de correo? Escríbenos a: <a href={`mailto:${CONTACT_EMAIL}`} style="color: var(--accent-cyan); font-weight: 600; text-decoration: underline;">{CONTACT_EMAIL}</a>
          </p>

          <p class="form-privacy-note" style="text-align: center; margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
            🔒 Tratamiento confidencial de la información de acuerdo con la <a href="/privacidad" style="color: var(--text-muted); text-decoration: underline;">Ley 25.326</a>. No recopilamos datos en bases de datos intermedias; la consulta se envía directamente por email a {FOUNDER_NAME}.
          </p>
        </form>

        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contact-form') as HTMLFormElement | null;
            if (form) {
              form.addEventListener('submit', (e) => {
                e.preventDefault();
                const nombre = (document.getElementById('contact-nombre') as HTMLInputElement)?.value || '';
                const empresa = (document.getElementById('contact-empresa') as HTMLInputElement)?.value || '';
                const email = (document.getElementById('contact-email') as HTMLInputElement)?.value || '';
                const telefono = (document.getElementById('contact-telefono') as HTMLInputElement)?.value || '';
                const servicio = (document.getElementById('contact-servicio') as HTMLSelectElement)?.value || '';
                const mensaje = (document.getElementById('contact-mensaje') as HTMLTextAreaElement)?.value || '';

                const subject = `[Consulta VASTTO] ${empresa} - ${nombre}`;
                const body = `Nombre: ${nombre}\nEmpresa: ${empresa}\nEmail: ${email}\nTeléfono: ${telefono}\nServicio de Interés: ${servicio}\n\nDetalle del Proyecto:\n${mensaje}`;

                window.location.href = `mailto:contacto@vastto.com.ar?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
              });
            }
          });
        </script>

        <div style="text-align: center; margin: 3rem 0 1.5rem 0; position: relative;">
          <div style="height: 1px; background: var(--border-subtle); position: absolute; top: 50%; left: 0; right: 0;"></div>
          <span style="position: relative; background: var(--bg-surface); padding: 0 1rem; font-size: 0.85rem; color: var(--text-muted);">Canales Oficiales de Contacto Directo</span>
        </div>

        <div class="direct-methods-grid">
          {WHATSAPP_ENABLED && (
            <a 
              href={getWhatsAppLink(WA_MESSAGES.contacto)} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="direct-method-card"
              style="border-color: rgba(37, 211, 102, 0.4);"
            >
              <div class="method-icon" style="color: #25D366;">💬</div>
              <div>
                <strong>WhatsApp Directo</strong>
                <span>{WHATSAPP_DISPLAY}</span>
              </div>
            </a>
          )}

          <a href={`mailto:${CONTACT_EMAIL}`} class="direct-method-card">
            <div class="method-icon" style="color: #00f0ff;">✉️</div>
            <div>
              <strong>Correo Electrónico</strong>
              <span>{CONTACT_EMAIL}</span>
            </div>
          </a>

          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="direct-method-card">
            <div class="method-icon" style="color: #6366f1;">💼</div>
            <div>
              <strong>LinkedIn Profesional</strong>
              <span>Perfil verificado de Andrés Carrizo</span>
            </div>
          </a>

          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="direct-method-card">
            <div class="method-icon" style="color: #10b981;">💻</div>
            <div>
              <strong>GitHub</strong>
              <span>Repositorios y código fuente</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-box {
    background: var(--bg-surface-card);
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    padding: 3.5rem;
    box-shadow: var(--shadow-card);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: #e2e8f0;
    margin-bottom: 0.5rem;
  }

  .form-input {
    width: 100%;
    background: #090b10;
    border: 1px solid var(--border-medium);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent-cyan);
    box-shadow: 0 0 0 3px rgba(0, 240, 255, 0.15);
  }

  .direct-methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .direct-method-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .direct-method-card:hover {
    border-color: var(--accent-cyan);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .method-icon {
    font-size: 1.4rem;
  }

  .direct-method-card strong {
    display: block;
    font-size: 0.88rem;
    color: #ffffff;
  }

  .direct-method-card span {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .contact-box {
      padding: 2rem 1.5rem;
    }
    .form-row, .direct-methods-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
